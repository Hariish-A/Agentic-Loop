# ===========================================================================
#  Template. Copy to .env and fill in your key:  cp .env.example .env
#
#  Verify with:   python scripts/preflight.py
#  Live check :   python scripts/preflight.py --ping
# ===========================================================================

# --- PRIMARY: GroqCloud, model openai/gpt-oss-120b -------------------------
# Get a key at https://console.groq.com/keys   (starts with gsk_)
GROQ_API_KEY=

# --- SECONDARY: local Ollama ----------------------------------------------
# No key required; config.yaml marks this provider requires_key: false.
# The placeholder just keeps the provider interface uniform.
OLLAMA_API_KEY=ollama

# ===========================================================================
#  Optional runtime overrides. These beat config/config.yaml but lose to CLI
#  flags. Uncomment only what you want to change.
#  Convention: AGENTIC_<SECTION>__<FIELD>  (double underscore = nesting)
# ===========================================================================

# AGENTIC_LLM__PRIMARY=ollama
# AGENTIC_LLM__PROVIDERS__GROQ__MODEL=openai/gpt-oss-20b
# AGENTIC_LOOP__MAX_ITERATIONS=6
# AGENTIC_LOOP__TARGET_SCORE=85
# AGENTIC_GUARDRAILS__TOKEN_BUDGET=200000
# AGENTIC_MEMORY__BACKEND=sqlite_fts
# AGENTIC_MEMORY__EMBEDDER=none
# AGENTIC_LOGGING__LEVEL=DEBUG
