# Copy to .env and fill in whichever provider(s) you use.
# The loop only needs ONE of these; the harness fails over between them.

# Primary - Google Gemini (free tier, no card required)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secondary - xAI Grok ($25 one-time signup credit)
# https://console.x.ai
XAI_API_KEY=

# Tertiary - local Ollama needs no key, but the var must exist for the
# uniform provider interface. Any non-empty placeholder works.
OLLAMA_API_KEY=ollama

# Optional - OpenAI / OpenRouter / Groq, all OpenAI-compatible
OPENAI_API_KEY=
OPENROUTER_API_KEY=
